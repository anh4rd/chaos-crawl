VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Public VAPID key used by the PWA push subscription. Never put the private key here.
VITE_VAPID_PUBLIC_KEY=

# Optional: public DSN from your Sentry React project. Empty disables reporting.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Optional: build-only credentials for uploading readable source maps.
# Keep the auth token in .env.local or CI secrets; never prefix it with VITE_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
